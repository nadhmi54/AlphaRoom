# Copy to .env and fill in — never commit the real .env file.

PORT=8080

# --- Local dev against the Supabase CLI's local stack (`supabase start`) ---
# Values below match the CLI's default local ports/keys. Run `supabase start`
# from the repo root (needs Docker Desktop) and it prints the exact values
# to use here (they don't change unless supabase/config.toml is edited).
#
# Running the backend directly with `npm run start:dev` (outside Docker):
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
#
# Running the backend via `docker compose up` while Supabase's local stack
# (a separate set of containers started by the Supabase CLI) runs on the
# same machine: "localhost" from inside the backend container is the
# container itself, not your machine, so it must use
# host.docker.internal instead —
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_SERVICE_ROLE_KEY=

# --- Production / staging: replace with your real Supabase project's values ---
# (Project Settings > API in the Supabase dashboard)
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_JWT_SECRET=[project JWT secret]
# SUPABASE_SERVICE_ROLE_KEY=[project service role key]
