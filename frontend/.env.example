# Copie ce fichier en .env (jamais commité) avant de lancer `npm run dev`.

# URL de l'API backend (NestJS). En Docker, injectée via --build-arg VITE_API_URL.
VITE_API_URL=/api

# --- Supabase (Auth) ---
# Valeurs par défaut : stack Supabase locale (`npx supabase start`, depuis la
# racine du repo — nécessite Docker Desktop).
# La clé anon ci-dessous est la clé publique par défaut de la CLI Supabase
# (identique pour tout le monde en local, ce n'est pas un secret) — elle est
# aussi affichée par `supabase status`.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Production / staging ---
# VITE_SUPABASE_URL=https://[project-ref].supabase.co
# VITE_SUPABASE_ANON_KEY=[clé anon du projet, Project Settings > API]
